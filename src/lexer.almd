// Original TOML 1.0 core scanner. Strings and positions are exact; numeric
// and calendar semantics are intentionally outside this reader's contract.
import gramide.lex
import gramide.tree
fn at(src: Bytes, i: Int) -> Int = bytes.get_or(src, i, -1)
fn digit(b: Int) -> Bool = b >= 48 and b <= 57
fn word(b: Int) -> Bool = digit(b) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 95 or b == 45
fn hex(b: Int) -> Bool = digit(b) or (b >= 65 and b <= 70) or (b >= 97 and b <= 102)
fn token(kind: Int, s: Int, e: Int, line: Int, base: Int) -> tree.Token = tree.Token { kind: kind, start: s, end: e, line: line, col: s - base + 1 }
fn boundary(b: Int) -> Bool = b == -1 or b == 32 or b == 9 or b == 10 or b == 13 or list.contains([35, 44, 91, 93, 123, 125, 61], b)
fn base_digit(b: Int, radix: Int) -> Bool = if radix == 16 then hex(b) else digit(b) and b - 48 < radix
fn digits(src: Bytes, start: Int, radix: Int) -> Int = {
  if not base_digit(at(src, start), radix) then -1 else {
    var i = start + 1
    var valid = true
    while valid and (base_digit(at(src, i), radix) or at(src, i) == 95) {
      if at(src, i) == 95 then {
        if base_digit(at(src, i + 1), radix) then i = i + 2 else valid = false
      } else i = i + 1
    }
    if valid then i else -1
  }
}
fn fixed_digits(src: Bytes, start: Int, count: Int) -> Bool = {
  var i = 0
  var valid = true
  while i < count { if not digit(at(src, start + i)) then valid = false else (); i = i + 1 }
  valid
}
fn time_end(src: Bytes, start: Int) -> Int = {
  if not (fixed_digits(src, start, 2) and at(src, start + 2) == 58 and fixed_digits(src, start + 3, 2) and at(src, start + 5) == 58 and fixed_digits(src, start + 6, 2)) then -1 else {
    var i = start + 8
    if at(src, i) == 46 then {
      i = i + 1
      if not digit(at(src, i)) then i = -1
      else { while digit(at(src, i)) { i = i + 1 } }
    } else ()
    i
  }
}
fn date_time(src: Bytes) -> Bool = {
  let n = bytes.len(src)
  let date = fixed_digits(src, 0, 4) and at(src, 4) == 45 and fixed_digits(src, 5, 2) and at(src, 7) == 45 and fixed_digits(src, 8, 2)
  if date and n == 10 then true
  else {
    let i = if date and list.contains([84, 116, 32], at(src, 10)) then time_end(src, 11)
      else if not date then time_end(src, 0) else -1
    if i < 0 then false
    else if i == n then true
    else if not date then false
    else if (at(src, i) == 90 or at(src, i) == 122) and i + 1 == n then true
    else list.contains([43, 45], at(src, i)) and fixed_digits(src, i + 1, 2) and at(src, i + 3) == 58 and fixed_digits(src, i + 4, 2) and i + 6 == n
  }
}
fn numeric(src: Bytes) -> Bool = {
  let n = bytes.len(src)
  let start = if list.contains([43, 45], at(src, 0)) then 1 else 0
  let tail = bytes.to_string_lossy(bytes.slice(src, start, n))
  if tail == "inf" or tail == "nan" then true
  else if date_time(src) then true
  else if start == 0 and at(src, 0) == 48 and list.contains([120, 111, 98], at(src, 1)) then {
    let radix = if at(src, 1) == 120 then 16 else if at(src, 1) == 111 then 8 else 2
    digits(src, 2, radix) == n
  } else {
    var i = digits(src, start, 10)
    var valid = i >= 0 and not (at(src, start) == 48 and i > start + 1)
    if valid and at(src, i) == 46 then {
      i = digits(src, i + 1, 10)
      valid = i >= 0
    } else ()
    if valid and list.contains([101, 69], at(src, i)) then {
      i = i + 1
      if list.contains([43, 45], at(src, i)) then i = i + 1 else ()
      i = digits(src, i, 10)
      valid = i >= 0
    } else ()
    valid and i == n
  }
}
fn bare_candidate(src: Bytes) -> Bool = {
  var i = 0
  var valid = bytes.len(src) > 0
  while i < bytes.len(src) {
    let c = at(src, i)
    if not word(c) and not (c == 46 and i > 0 and word(at(src, i - 1)) and word(at(src, i + 1))) then valid = false else ()
    i = i + 1
  }
  valid
}

fn scan(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = {
  let src = bytes.from_string(source)
  let n = bytes.len(src)
  var out: List[tree.Token] = []
  var i = 0
  var line = 1
  var base = 0
  while i < n {
    let b = at(src, i)
    if b == 32 or b == 9 then i = i + 1
    else if b == 35 then {
      while i < n and at(src, i) != 10 and at(src, i) != 13 { i = i + 1 }
    } else if b == 13 and at(src, i + 1) != 10 then {
      guard recovering else err(lex.LexError { line: line, col: i - base + 1, message: "bare CR is not a TOML newline" })
      list.push(out, token(tree.T_ERROR, i, i + 1, line, base))
      i = i + 1
    } else if b == 10 or b == 13 then {
      let end = i + (if b == 13 and at(src, i + 1) == 10 then 2 else 1)
      list.push(out, token(tree.T_NEWLINE, i, end, line, base))
      i = end; line = line + 1; base = i
    } else {
      let start = i
      let start_line = line
      let start_base = base
      var kind = tree.T_PUNCT
      var failure = ""
      if b == 34 or b == 39 then {
        kind = tree.T_STRING
        let triple = at(src, i + 1) == b and at(src, i + 2) == b
        i = i + (if triple then 3 else 1)
        var closed = false
        while i < n and not closed and failure == "" {
          let c = at(src, i)
          if c == 13 and at(src, i + 1) != 10 then failure = "bare CR in TOML string"
          else if c == b then {
            if not triple then { i = i + 1; closed = true }
            else if at(src, i + 1) == b and at(src, i + 2) == b then {
              i = i + 3
              var extra = 0
              while extra < 2 and at(src, i) == b { i = i + 1; extra = extra + 1 }
              closed = true
            } else i = i + 1
          } else if (c == 10 or c == 13) and not triple then failure = "newline in single-line TOML string"
          else if c == 127 or (c < 32 and not list.contains([9, 10, 13], c)) then failure = "control character in TOML string"
          else if b == 34 and c == 92 then {
            i = i + 1
            if list.contains([34, 92, 98, 116, 110, 102, 114], at(src, i)) then i = i + 1
            else if at(src, i) == 117 or at(src, i) == 85 then {
              let width = if at(src, i) == 117 then 4 else 8
              i = i + 1
              var k = 0
              while k < width and failure == "" {
                if hex(at(src, i)) then { i = i + 1; k = k + 1 } else failure = "invalid TOML unicode escape"
              }
            } else if triple and list.contains([32, 9, 10, 13], at(src, i)) then {
              var newline = false
              while list.contains([32, 9, 10, 13], at(src, i)) {
                if at(src, i) == 10 or at(src, i) == 13 then newline = true else ()
                if at(src, i) == 13 and at(src, i + 1) != 10 then failure = "bare CR in TOML line continuation" else ()
                i = i + 1
              }
              if not newline then failure = "TOML line continuation needs a newline" else ()
            } else failure = "invalid TOML escape"
          } else i = i + 1
        }
        if not closed and failure == "" then failure = "unterminated TOML string" else ()
      } else if digit(b) or b == 43 or (b == 45 and (digit(at(src, i + 1)) or at(src, i + 1) == 105 or at(src, i + 1) == 110)) then {
        kind = tree.T_NUMBER
        i = i + 1
        while not boundary(at(src, i)) and at(src, i) != 34 and at(src, i) != 39 and
          not (at(src, i) == 46 and list.contains([34, 39], at(src, i + 1))) { i = i + 1 }
        // TOML permits a space instead of T between date and time.
        if i - start == 10 and at(src, start + 4) == 45 and at(src, start + 7) == 45 and at(src, i) == 32 and digit(at(src, i + 1)) and digit(at(src, i + 2)) and at(src, i + 3) == 58 then {
          i = i + 1
          while not boundary(at(src, i)) { i = i + 1 }
        } else ()
        let candidate = bytes.slice(src, start, i)
        if not numeric(candidate) then {
          if bare_candidate(candidate) then kind = tree.T_IDENTIFIER
          else failure = "invalid TOML number or bare key"
        } else ()
      } else if word(b) then {
        kind = tree.T_IDENTIFIER
        i = i + 1
        while word(at(src, i)) { i = i + 1 }
      } else {
        i = i + 1
        if not list.contains([91, 93, 123, 125, 61, 44, 46], b) then failure = "unexpected byte in TOML" else ()
      }
      if failure != "" then {
        guard recovering else err(lex.LexError { line: start_line, col: start - start_base + 1, message: failure })
        kind = tree.T_ERROR
      } else ()
      list.push(out, token(kind, start, i, start_line, start_base))
      var pos = start
      while pos < i {
        if at(src, pos) == 10 then { pos = pos + 1; line = line + 1; base = pos }
        else pos = pos + 1
      }
    }
  }
  list.push(out, token(tree.T_EOF, n, n, line, base))
  ok(out)
}

test "TOML literals preserve source boundaries and line positions" {
  let src = "title = \"日本語\"\r\ntext = '''first\nsecond'''\nanswer = 42\n"
  let ts = scan(src, false) |> result.map_err((e) => e.message)!
  let answer = list.get(ts, 8)!
  assert_eq(tree.token_text(bytes.from_string(src), answer), "answer")
  assert_eq(answer.line, 4)
  assert_eq(answer.col, 1)
  for bad in ["x = \"unfinished", "x = 'one\ntwo'", "x = \"\\q\"", "x = \"\\uGGGG\""] { assert(result.is_err(scan(bad, false))) }
  for bad in ["x=1\ry=2", "x='''one\rtwo'''", "x=\"\"\"a\\\rb\"\"\""] { assert(result.is_err(scan(bad, false))) }
  for bad in ["1\u{0001}b=2", "1\u{000c}b=2", "1\u{007f}b=2", "x=1979-05-27 07:32:00\u{0001}Z"] { assert(result.is_err(scan(bad, false))) }
}
